import { AboutSlint, Button, CheckBox, ComboBox, LineEdit, Palette, SpinBox, TabWidget, ListView, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct ItemRow {
    name: string,
    hint: string,
    enabled: bool,
    label: string,
    default-label: string,
    color: string,
}

export struct FanPoint {
    temp: int,
    speed: int,
}

export global Bridge {
    pure callback parse-color(string) -> color;
    callback pick-color(string) -> string;
}

component FieldLabel inherits Text {
    vertical-alignment: center;
    min-width: 170px;
    horizontal-stretch: 0;
}

component Hint inherits Text {
    wrap: word-wrap;
    font-size: 12px;
    color: Palette.foreground.with-alpha(0.65);
}

component ColorField inherits HorizontalLayout {
    in property <string> placeholder;
    in-out property <string> value;
    callback edited();
    spacing: 8px;

    Rectangle {
        width: 32px;
        height: 32px;
        y: (parent.height - self.height) / 2;
        border-radius: 4px;
        border-width: 1px;
        border-color: Palette.border;
        background: Bridge.parse-color(root.value);
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.value = Bridge.pick-color(root.value);
                root.edited();
            }
        }
    }
    LineEdit {
        text <=> root.value;
        placeholder-text: root.placeholder;
        edited => {
            root.edited();
        }
    }
}

// The chart spans these temperatures. Its right edge is where the service forces
// the fans to 100%.
global FanAxis {
    out property <int> temp-min: 20;
    out property <int> temp-span: 70;
}

component FanChart inherits Rectangle {
    in property <[FanPoint]> points;
    in property <bool> active;
    callback add-point(float, float);
    callback move-point(int, float, float);
    callback remove-point(int);
    callback released();

    pure function chart-x(temp: int) -> float {
        (temp - FanAxis.temp-min) / FanAxis.temp-span * root.width / 1px
    }
    pure function chart-y(speed: int) -> float {
        (1 - speed / 100) * root.height / 1px
    }

    background: Palette.alternate-background;
    border-width: 1px;
    border-color: Palette.border;
    opacity: root.active ? 1 : 0.5;

    // Below the first point, the card controls its own fans.
    if root.points.length > 0: Rectangle {
        x: 0;
        width: (root.points[0].temp - FanAxis.temp-min) / FanAxis.temp-span * root.width;
        background: Palette.foreground.with-alpha(0.06);
        Text {
            text: "Automático";
            font-size: 12px;
            color: Palette.foreground.with-alpha(0.65);
            visible: parent.width > 70px;
        }
    }

    for tick in [25, 50, 75]: Rectangle {
        y: (1 - tick / 100) * root.height;
        height: 1px;
        background: Palette.border;
    }
    for tick in [30, 40, 50, 60, 70, 80]: Rectangle {
        x: (tick - FanAxis.temp-min) / FanAxis.temp-span * root.width;
        width: 1px;
        background: Palette.border;
    }
    for tick in [30, 50, 70]: Text {
        x: (tick - FanAxis.temp-min) / FanAxis.temp-span * root.width + 3px;
        y: root.height - self.height - 2px;
        text: tick + " °C";
        font-size: 11px;
        color: Palette.foreground.with-alpha(0.65);
    }
    for tick in [25, 50, 75]: Text {
        x: 3px;
        y: (1 - tick / 100) * root.height + 1px;
        text: tick + "%";
        font-size: 11px;
        color: Palette.foreground.with-alpha(0.65);
    }

    // In pixels: a Path keeps the proportions of its viewbox, so anything else would
    // leave the line out of step with the points when the window changes shape.
    for point[i] in root.points: Rectangle {
        if i > 0: Path {
            width: root.width;
            height: root.height;
            viewbox-width: root.width / 1px;
            viewbox-height: root.height / 1px;
            stroke: Palette.accent-background;
            stroke-width: 2px;
            MoveTo {
                x: root.chart-x(root.points[i - 1].temp);
                y: root.chart-y(root.points[i - 1].speed);
            }
            LineTo {
                x: root.chart-x(point.temp);
                y: root.chart-y(point.speed);
            }
        }
        // The fans hold the last speed past the last point.
        if i == root.points.length - 1: Path {
            width: root.width;
            height: root.height;
            viewbox-width: root.width / 1px;
            viewbox-height: root.height / 1px;
            stroke: Palette.accent-background;
            stroke-width: 2px;
            MoveTo {
                x: root.chart-x(point.temp);
                y: root.chart-y(point.speed);
            }
            LineTo {
                x: root.width / 1px;
                y: root.chart-y(point.speed);
            }
        }
    }

    TouchArea {
        enabled: root.active;
        clicked => {
            root.add-point(self.pressed-x / root.width, self.pressed-y / root.height);
        }
    }

    for point[i] in root.points: dot := Rectangle {
        x: (point.temp - FanAxis.temp-min) / FanAxis.temp-span * root.width - self.width / 2;
        y: (1 - point.speed / 100) * root.height - self.height / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: Palette.accent-background;
        border-width: 2px;
        border-color: Palette.background;
        TouchArea {
            enabled: root.active;
            mouse-cursor: move;
            moved => {
                if self.pressed {
                    root.move-point(i, (dot.x + self.mouse-x) / root.width, (dot.y + self.mouse-y) / root.height);
                }
            }
            pointer-event(event) => {
                if event.kind == PointerEventKind.up {
                    root.released();
                }
            }
            double-clicked => {
                root.remove-point(i);
            }
        }
    }
}

export component SettingsWindow inherits Window {
    title: "Open Hardware Info - Configurações";
    icon: @image-url("../assets/icon-64.png");
    preferred-width: 620px;
    preferred-height: 520px;
    min-width: 620px;
    min-height: 420px;

    // Appearance
    in property <[string]> font-names;
    in-out property <int> font-index;
    in-out property <int> font-size;
    in-out property <int> weight-index;
    in-out property <int> layout-index;
    in-out property <string> text-color;
    in-out property <string> background-color;
    // Items
    in-out property <[ItemRow]> items;
    in property <bool> sensor-installed;
    callback install-sensor();
    // GPU fans
    in-out property <bool> fan-enabled;
    in-out property <[FanPoint]> fan-points;
    in property <string> fan-status;
    in property <bool> fan-service-ready;
    callback install-fan-control();
    callback fan-add-point(float, float);
    callback fan-move-point(int, float, float);
    callback fan-remove-point(int);
    // Position
    in property <[string]> monitor-names;
    in-out property <int> monitor-index;
    in-out property <int> anchor-index;
    in-out property <int> offset;
    in-out property <int> secondary-reserve;
    // General
    in-out property <int> interval;
    in-out property <string> adapter;
    in-out property <bool> autostart;
    in property <string> version;
    // Status
    in property <string> message;
    in property <bool> message-is-error;

    callback changed();
    callback move-item(int, int);
    callback autostart-toggled(bool);
    callback open-file();
    callback restore-defaults();

    property <bool> restore-armed: false;

    VerticalBox {
        if root.message != "": Rectangle {
            background: root.message-is-error ? #c4282833 : Palette.alternate-background;
            border-radius: 4px;
            HorizontalBox {
                Text {
                    text: root.message;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }
        }

        TabWidget {
            Tab {
                title: "Aparência";
                VerticalBox {
                    alignment: start;
                    HorizontalBox {
                        padding: 0;
                        FieldLabel { text: "Fonte"; }
                        ComboBox {
                            model: root.font-names;
                            current-index <=> root.font-index;
                            selected => { root.changed(); }
                        }
                    }
                    HorizontalBox {
                        padding: 0;
                        FieldLabel { text: "Tamanho (pt)"; }
                        SpinBox {
                            minimum: 5;
                            maximum: 30;
                            value <=> root.font-size;
                            edited => { root.changed(); }
                        }
                    }
                    HorizontalBox {
                        padding: 0;
                        FieldLabel { text: "Peso"; }
                        ComboBox {
                            model: ["Normal", "Seminegrito", "Negrito"];
                            current-index <=> root.weight-index;
                            selected => { root.changed(); }
                        }
                    }
                    HorizontalBox {
                        padding: 0;
                        FieldLabel { text: "Disposição"; }
                        ComboBox {
                            model: ["Lado a lado", "Um em cima do outro (2 linhas)", "Um em cima do outro (3 linhas)"];
                            current-index <=> root.layout-index;
                            selected => { root.changed(); }
                        }
                    }
                    HorizontalBox {
                        padding: 0;
                        FieldLabel { text: "Cor do texto"; }
                        ColorField {
                            placeholder: "Automática (segue o tema do Windows)";
                            value <=> root.text-color;
                            edited => { root.changed(); }
                        }
                    }
                    HorizontalBox {
                        padding: 0;
                        FieldLabel { text: "Cor de fundo"; }
                        ColorField {
                            placeholder: "Transparente, ou #RRGGBBAA";
                            value <=> root.background-color;
                            edited => { root.changed(); }
                        }
                    }
                    Hint { text: "As mudanças aparecem na barra de tarefas enquanto você edita."; }
                    Hint { text: "Lado a lado ocupa mais largura. Se cobrir os ícones da barra, use o lado esquerdo na aba Posição ou mostre menos itens."; }
                }
            }

            Tab {
                title: "Itens";
                VerticalBox {
                    Hint { text: "Marque o que deseja ver. As setas mudam a ordem na barra. Rótulo e cor são opcionais."; }
                    ListView {
                        for item[i] in root.items: HorizontalBox {
                            padding-left: 0;
                            padding-top: 2px;
                            padding-bottom: 2px;
                            VerticalLayout {
                                width: 190px;
                                alignment: center;
                                CheckBox {
                                    text: item.name;
                                    checked <=> item.enabled;
                                    toggled => { root.changed(); }
                                }
                                // Lines up with the checkbox text above it.
                                if item.hint != "" && !root.sensor-installed: HorizontalLayout {
                                    padding-left: 30px;
                                    spacing: 6px;
                                    alignment: start;
                                    Hint { text: item.hint; }
                                    Text {
                                        text: "Instalar";
                                        font-size: 12px;
                                        color: Palette.accent-background;
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.install-sensor(); }
                                        }
                                    }
                                }
                            }
                            LineEdit {
                                width: 80px;
                                height: 32px;
                                text <=> item.label;
                                placeholder-text: item.default-label;
                                edited => { root.changed(); }
                            }
                            ColorField {
                                height: 32px;
                                placeholder: "Cor";
                                value <=> item.color;
                                edited => { root.changed(); }
                            }
                            Button {
                                text: "↑";
                                width: 34px;
                                height: 32px;
                                enabled: i > 0;
                                clicked => { root.move-item(i, -1); }
                            }
                            Button {
                                text: "↓";
                                width: 34px;
                                height: 32px;
                                enabled: i < root.items.length - 1;
                                clicked => { root.move-item(i, 1); }
                            }
                        }
                    }
                }
            }

            Tab {
                title: "Fans";
                VerticalBox {
                    CheckBox {
                        text: "Controlar os fans da GPU com esta curva";
                        enabled: root.fan-service-ready;
                        checked <=> root.fan-enabled;
                        toggled => { root.changed(); }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Hint { text: root.fan-status; }
                        if !root.fan-service-ready: Text {
                            text: "Instalar";
                            font-size: 12px;
                            color: Palette.accent-background;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.install-fan-control(); }
                            }
                        }
                    }
                    FanChart {
                        vertical-stretch: 1;
                        min-height: 150px;
                        points: root.fan-points;
                        active: root.fan-service-ready;
                        add-point(x, y) => { root.fan-add-point(x, y); }
                        move-point(i, x, y) => { root.fan-move-point(i, x, y); }
                        remove-point(i) => { root.fan-remove-point(i); }
                        released => { root.changed(); }
                    }
                    Hint { text: "Arraste um ponto para ajustar. Clique no gráfico para criar um ponto, e dê dois cliques em um ponto para removê-lo."; }
                    Hint { text: "A curva só vale com o app aberto. Ao fechá-lo, a placa volta ao próprio controle automático. A partir de 90 °C, os fans vão a 100%, seja qual for a curva. Velocidade baixa demais pode danificar a GPU."; }
                }
            }

            Tab {
                title: "Posição";
                VerticalBox {
                    alignment: start;
                    HorizontalBox {
                        padding: 0;
                        FieldLabel { text: "Monitor"; }
                        ComboBox {
                            model: root.monitor-names;
                            current-index <=> root.monitor-index;
                            selected => { root.changed(); }
                        }
                    }
                    HorizontalBox {
                        padding: 0;
                        FieldLabel { text: "Lado da barra"; }
                        ComboBox {
                            model: ["Esquerda", "Direita"];
                            current-index <=> root.anchor-index;
                            selected => { root.changed(); }
                        }
                    }
                    HorizontalBox {
                        padding: 0;
                        FieldLabel { text: "Distância da borda"; }
                        SpinBox {
                            minimum: 0;
                            maximum: 2000;
                            value <=> root.offset;
                            edited => { root.changed(); }
                        }
                    }
                    HorizontalBox {
                        padding: 0;
                        FieldLabel { text: "Reserva no 2º monitor"; }
                        SpinBox {
                            minimum: 0;
                            maximum: 2000;
                            value <=> root.secondary-reserve;
                            edited => { root.changed(); }
                        }
                    }
                    Hint { text: "A reserva é o espaço deixado para o relógio nas barras de monitores secundários, onde o Windows não informa a posição dele."; }
                }
            }

            Tab {
                title: "Geral";
                VerticalBox {
                    alignment: start;
                    CheckBox {
                        text: "Iniciar com o Windows";
                        checked <=> root.autostart;
                        toggled => { root.autostart-toggled(self.checked); }
                    }
                    HorizontalBox {
                        padding: 0;
                        FieldLabel { text: "Atualizar a cada (ms)"; }
                        SpinBox {
                            minimum: 250;
                            maximum: 60000;
                            step-size: 250;
                            value <=> root.interval;
                            edited => { root.changed(); }
                        }
                    }
                    HorizontalBox {
                        padding: 0;
                        FieldLabel { text: "Adaptador de rede"; }
                        LineEdit {
                            placeholder-text: "Todos (ou parte do nome, ex.: Ethernet)";
                            text <=> root.adapter;
                            edited => { root.changed(); }
                        }
                    }
                    HorizontalBox {
                        padding: 0;
                        alignment: start;
                        Button {
                            text: "Abrir config.toml";
                            clicked => { root.open-file(); }
                        }
                        Button {
                            text: root.restore-armed ? "Clique de novo para confirmar" : "Restaurar padrões";
                            clicked => {
                                if root.restore-armed {
                                    root.restore-armed = false;
                                    root.restore-defaults();
                                } else {
                                    root.restore-armed = true;
                                }
                            }
                        }
                    }
                }
            }

            Tab {
                title: "Sobre";
                VerticalBox {
                    alignment: start;
                    Text {
                        text: "Open Hardware Info";
                        font-size: 18px;
                        font-weight: 600;
                    }
                    Hint { text: "Versão " + root.version; }
                    Hint { text: "Monitor de recursos na barra de tarefas, sem driver próprio."; }
                    AboutSlint { max-height: 180px; }
                }
            }
        }
    }
}
